n> <div class="nav-links"> <a href="/">v2</a> <a href="/v1/">v1</a> <a href="/currencies/">Currencies</a> <a href="/providers/" aria-current="page">Providers</a> <a href="/integrations/">Integrations</a> <a href="/deploy/">Deploy</a> <a href="https://api.frankfurter.dev/v2/openapi.json" target="_blank" rel="noopener">OpenAPI</a> </div> </nav> <main> <div id="site-logo"> <picture> <source srcset="/images/logo-dark.png?v=1791051249" media="(prefers-color-scheme: dark)" /> <img class="icon" src="/images/logo.png?v=1791051249" alt="Frankfurter" width="240" height="128" /> </picture> </div> <header id="site-header"> <h1>Central Bank of Sri Lanka</h1> <div class="subtitle"><code>CBSL</code> &middot; Sri Lanka &middot; LKR</div> </header> <div id="provider-show" data-key="CBSL" data-currencies="AED,AUD,BDT,BHD,BND,BRL,CAD,CHF,CNH,CNY,CZK,DKK,EGP,EUR,GBP,GHS,HKD,HUF,IDR,INR,IRR,JOD,JPY,KES,KRW,KWD,LKR,MMK,MOP,MUR,MVR,MYR,NGN,NOK,NPR,NZD,OMR,PGK,PHP,PKR,PLN,QAR,RON,RUB,SAR,SBD,SCR,SEK,SGD,THB,TWD,USD,VND,XAU,ZAR,ZMW" data-end-date="2026-10-02"> <div id="provider-meta"> <ul> <li>2011–present</li> <li>Indicative rate</li> <li><span class="provider-toggle" onclick="var s=this;s.innerHTML=s.dataset.list;s.classList.add('expanded');s.onclick=null;s.style.cursor='default';s.style.textDecoration='none'" data-list="<a href=&quot;/currencies/aed/&quot;>AED</a>, <a href=&quot;/currencies/aud/&quot;>AUD</a>, <a href=&quot;/currencies/bdt/&quot;>BDT</a>, <a href=&quot;/currencies/bhd/&quot;>BHD</a>, <a href=&quot;/currencies/bnd/&quot;>BND</a>, <a href=&quot;/currencies/brl/&quot;>BRL</a>, <a href=&quot;/currencies/cad/&quot;>CAD</a>, <a href=&quot;/currencies/chf/&quot;>CHF</a>, <a href=&quot;/currencies/cnh/&quot;>CNH</a>, <a href=&quot;/currencies/cny/&quot;>CNY</a>, <a href=&quot;/currencies/czk/&quot;>CZK</a>, <a href=&quot;/currencies/dkk/&quot;>DKK</a>, <a href=&quot;/currencies/egp/&quot;>EGP</a>, <a href=&quot;/currencies/eur/&quot;>EUR</a>, <a href=&quot;/currencies/gbp/&quot;