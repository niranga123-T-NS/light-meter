# Supabase project (Settings > API). The anon/publishable key is safe in the app: all access is enforced by row-level security.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Show "Sign in with Microsoft" (requires the Azure provider in Supabase Auth)
EXPO_PUBLIC_MICROSOFT_SSO=false
