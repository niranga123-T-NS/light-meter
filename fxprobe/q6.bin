<!doctype html> <html lang="en"> <head> <meta charset="UTF-8" /> <meta name="viewport" content="width=device-width, initial-scale=1.0" /> <meta name="color-scheme" content="light dark" /> <meta name="theme-color" content="#fcfcfc" media="(prefers-color-scheme: light)" /> <meta name="theme-color" content="#181818" media="(prefers-color-scheme: dark)" /> <meta name="description" content="Free, open-source exchange rates API sourcing from 104 central banks and official sources. Current and historical rates for 223 currencies. No API key required." /> <title>Frankfurter | Free exchange rates API</title> <link rel="canonical" href="https://frankfurter.dev/" /> <link rel="alternate" hreflang="en" href="https://frankfurter.dev/" /> <link rel="alternate" hreflang="de" href="https://frankfurter.dev/de/" /> <link rel="alternate" hreflang="es" href="https://frankfurter.dev/es/" /> <link rel="alternate" hreflang="fr" href="https://frankfurter.dev/fr/" /> <link rel="alternate" hreflang="it" href="https://frankfurter.dev/it/" /> <link rel="alternate" hreflang="pt" href="https://frankfurter.dev/pt/" /> <link rel="alternate" hreflang="tr" href="https://frankfurter.dev/tr/" /> <link rel="alternate" hreflang="nl" href="https://frankfurter.dev/nl/" /> <link rel="alternate" hreflang="pl" href="https://frankfurter.dev/pl/" /> <link rel="alternate" hreflang="ja" href="https://frankfurter.dev/ja/" /> <link rel="alternate" hreflang="ko" href="https://frankfurter.dev/ko/" /> <link rel="alternate" hreflang="x-default" href="https://frankfurter.dev/" /> <link rel="alternate" type="text/markdown" href="/llms.txt" title="Frankfurter for LLMs" /> <link rel="stylesheet" href="/stylesheets/application.css?v=1791051249" /> <link id="favicon-svg" rel="icon" type="image/svg+xml" sizes="any" href="/images/favicon.svg?v=1791051249" /> <link id="favicon-png" rel="icon" type="image/png" sizes="512x512" href="/images/logo.png?v=1791051249" /> <script> (function () { var m = window.matchMedia("(prefers-color-scheme: dark)"); var svg = document.getElementById("favicon-svg"); var png = document.getElementById("favicon-png"); var v = "1791051249"; function update() { var mode = m.matches ? "-dark" : ""; if (svg) svg.href = "/images/favicon" + mode + ".svg?v=" + v; if (png) png.href = "/images/logo" + mode + ".png?v=" + v; } update(); m.addEventListener("change", update); })(); </script> <!-- Open Graph tags --> <meta property="og:title" content="Frankfurter | Free exchange rates API" /> <meta property="og:description" content="Free, open-source exchange rates API sourcing from 104 central banks and official sources. Current and historical rates for 223 currencies. No API key required." /> <meta property="og:type" content="website" /> <meta property="og:url" content="https://frankfurter.dev/" /> <meta property="og:image" content="https://frankfurter.dev/images/social.png" /> <meta property="og:image:width" content="1200" /> <meta property="og:image:height" content="1200" /> <meta property="og:image:type" content="image/png" /> <meta property="og:site_name" content="Frankfurter" /> <meta property="og:locale" content="en_US" /> <!-- Twitter Card tags --> <meta name="twitter:card" content="summary" /> <meta name="twitter:title" content="Frankfurter | Free exchange rates API" /> <meta name="twitter:description" content="Free, open-source exchange rates API sourcing from 104 central banks and official sources. Current and historical rates for 223 currencies. No API key required." /> <meta name="twitter:image" content="https://frankfurter.dev/images/social.png" /> <!-- Schema.org Structured Data --> <script type="application/ld+json"> { "@context": "https://schema.org", "@type": "WebApplication", "name": "Frankfurter", "url": "https://frankfurter.dev", "image": "https://frankfurter.dev/images/logo.png", "applicationCategory": "DeveloperApplication", "operatingSystem": "All", "description": "Free, open-source exchange rates API sourcing from 104 central banks and official sources. Current and historical rates for 223 currencies. No API key required." } </script> <script defer src="/vendor/highlight/highlight.min.js?v=1791051249" ></script> <script defer src="/vendor/mustache.min.js?v=1791051249" ></script> <script defer src="/vendor/code-editor.js?v=1791051249" ></script> <script defer src="/javascripts/history.js?v=1791051249" ></script> <script defer src="/javascripts/application.js?v=1791051249" ></script> <!-- Structured data --> <script type="application/ld+json"> { "@context": "https://schema.org", "@graph": [ { "@type": "WebAPI", "@id": "https://frankfurter.dev/#api", "name": "Frankfurter", "url": "https://frankfurter.dev", "description": "Free, open-source API for exchange rates from 104 central banks and official sources. Current and historical rates for 223 currencies.", "image": "https://frankfurter.dev/images/social.png", "documentation": "https://frankfurter.dev" }, { "@type": "WebSite", "@id": "https://frankfurter.dev/#website", "name": "Frankfurter", "url": "https://frankfurter.dev", "about": { "@id": "https://frankfurter.dev/#api" }, "hasPart": [ { "@type": "WebPage", "name": "API Docs", "url": "https://frankfurter.dev/" }, { "@type": "WebPage", "name": "v1", "url": "https://frankfurter.dev/v1/" }, { "@type": "WebPage", "name": "Providers", "url": "https://frankfurter.dev/providers/" }, { "@type": "WebPage", "name": "MCP", "url": "https://frankfurter.dev/mcp/" }, { "@type": "WebPage", "name": "Integrations", "url": "https://frankfurter.dev/integrations/" }, { "@type": "WebPage", "name": "Google Sheets", "url": "https://frankfurter.dev/google-sheets/" }, { "@type": "WebPage", "name": "Excel", "url": "https://frankfurter.dev/excel/" }, { "@type": "WebPage", "name": "pandas", "url": "https://frankfurter.dev/pandas/" }, { "@type": "WebPage", "name": "Python", "url": "https://frankfurter.dev/python/" }, { "@type": "WebPage", "name": "JavaScript", "url": "https://frankfurter.dev/javascript/" }, { "@type": "WebPage", "name": "Deploy", "url": "https://frankfurter.dev/deploy/" }, { "@type": "WebPage", "name": "Playground", "url": "https://frankfurter.dev/playground/" }, { "@type": "WebPage", "name": "License", "url": "https://frankfurter.dev/license/" } ] } ] } </script> <!-- Plausible Analytics --> <script async src="https://plausible.io/js/pa-buMFGk6Tn9-FC2QOnSmHR.js" ></script> <script> ((window.plausible = window.plausible || function () { (plausible.q = plausible.q || []).push(arguments); }), (plausible.init = plausible.init || function (i) { plausible.o = i || {}; })); plausible.init(); </script> </head> <body> <div id="response-modal" class="response-modal"> <button class="response-modal-close icon-btn" aria-label="Close" title="Close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></button> <div class="response-modal-content"><pre><code></code></pre></div> </div> <script> if (new URLSearchParams(location.search).get("expand")) { document.getElementById("response-modal").classList.add("open"); document.body.style.overflow = "hidden"; } </script> <nav> <div class="nav-progress" aria-hidden="true"></div> <button class="burger icon-btn" aria-label="Menu" > <svg class="icon-menu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg> <svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg> </button> <div class="nav-links"> <a href="/" aria-current="page">v2</a> <a href="/v1/">v1</a> <a href="/currencies/">Currencies</a> <a href="/providers/">Providers</a> <a href="/integrations/">Integrations</a> <a href="/deploy/">Deploy</a> <a href="https://api.frankfurter.dev/v2/openapi.json" target="_blank" rel="noopener">OpenAPI</a> </div> </nav> <main> <div id="site-logo"> <picture> <source srcset="/images/logo-dark.png?v=1791051249" media="(prefers-color-scheme: dark)" /> <img class="icon" src="/images/logo.png?v=1791051249" alt="Frankfurter" width="240" height="128" /> </picture> </div> <header id="site-header"> <h1><span data-nosnippet>Frankfurter</span></h1> <div class="subtitle" data-nosnippet>Exchange rates and currency data API</div> <div class="project-links" data-nosnippet> <a class="btn-outline gh-star-btn" href="https://github.com/lineofflight/frankfurter" target="_blank" rel="noopener" data-repo="lineofflight/frankfurter" aria-label="GitHub repository (1,932 stars)" > <svg viewBox="0 0 16 16" fill="currentColor"> <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" /> </svg> <span class="star-count">1,932</span> </a> <a href="/playground/">Playground</a> </div> </header> <script defer src="/javascripts/logo.js?v=1791051249"></script> <script defer src="/javascripts/faq-scene.js?v=1791051249"></script> <p> Frankfurter is a free exchange rates API for <a href="/currencies/" ><span id="currency-count">223</span> currencies</a> from <a href="/providers/" ><span id="provider-count">104</span> central banks and official sources</a>. Rates update daily and go back to <span id="start-year">1948</span>. </p> <p> The public API lives at <a href="https://api.frankfurter.dev">api.frankfurter.dev</a>. You don't need an API key. The project is open source, so you can also <a href="/deploy/">self-host</a> for full control. </p> <p> Working with an AI agent? Point it at <a href="/llms.txt">llms.txt</a>, or add the <a href="/mcp/">MCP server</a>. </p> <h2 id="rates">Rates</h2> <p>Fetch the latest exchange rates.</p><pre><code class="language-json">curl https://api.frankfurter.dev/v2/rates</code></pre><p>Change the base currency with <code>base</code>.</p><pre><code class="language-json">curl https://api.frankfurter.dev/v2/rates?base=usd</code></pre><p>Filter target currencies with <code>quotes</code>.</p><pre><code class="language-json">curl https://api.frankfurter.dev/v2/rates?quotes=usd,gbp</code></pre><h3 id="historical-rates">Historical Rates</h3> <p>Look up rates for a specific date.</p><pre><code class="language-json">curl https://api.frankfurter.dev/v2/rates?date=1999-01-04</code></pre><h3 id="time-series">Time Series</h3> <p>Fetch rates over a period with <code>from</code> and <code>to</code>.</p><pre><code class="language-json">curl https://api.frankfurter.dev/v2/rates?from=2026-01-01&amp;quotes=usd</code></pre><p> <strong>Tip:</strong> Narrowing down currencies keeps responses small. For large date ranges, request <a href="#ndjson">NDJSON</a> to stream results line by line. </p> <h3 id="grouping">Grouping</h3> <p>Downsample a time series with <code>group</code>. Supports <code>week</code> and <code>month</code>.</p><pre><code class="language-json">curl https://api.frankfurter.dev/v2/rates?from=2026-01-01&amp;group=month</code></pre><h3 id="filtering-by-provider">Filtering by Provider</h3> <p>Scope to specific providers with <code>providers</code>.</p><pre><code class="language-json">curl https://api.frankfurter.dev/v2/rates?providers=ecb</code></pre><p> By default, rates are blended across all providers. Use <code>providers</code> to get rates from a specific provider, or use <a href="#rates-by-provider">provider routes</a> to query a provider directly. </p> <h3 id="provider-attribution">Provider Attribution</h3> <p> Add <code>expand=providers</code> to see which providers contributed to each blended rate. </p><pre><code class="language-json">curl https://api.frankfurter.dev/v2/rates?expand=providers</code></pre><p> Each row gains a <code>providers</code> array of contributing provider keys. Pegged-currency rows omit the field. Those rates come from the peg, not provider data. </p> <h3 id="csv">CSV Output</h3> <p> Rates are also available as CSV. Append <code>.csv</code> to the path or set the <code>Accept</code> header to <code>text/csv</code>. </p><pre><code class="language-csv">curl https://api.frankfurter.dev/v2/rates.csv</code></pre><h3 id="ndjson">NDJSON Output</h3> <p> For large responses, request <a href="https://github.com/ndjson/ndjson-spec" target="_blank" rel="noopener">NDJSON</a> (newline-delimited JSON) by setting the <code>Accept</code> header to <code>application/x-ndjson</code>. Each line is one independent JSON object, useful for streaming large time series without buffering the entire response. </p><pre><code class="language-ndjson">curl https://api.frankfurter.dev/v2/rates?from=2026-01-01</code></pre><h2 id="rate">Rate</h2> <p> Get the rate for a single currency pair. Optionally add <code>date</code> or <code>providers</code>. </p><pre><code class="language-json">curl https://api.frankfurter.dev/v2/rate/eur/usd</code></pre><h2 id="currencies">Currencies</h2> <p>Get available currencies with provider coverage.</p><pre><code class="language-json">curl https://api.frankfurter.dev/v2/currencies</code></pre><p>Include legacy currencies with <code>scope</code>.</p><pre><code class="language-json">curl https://api.frankfurter.dev/v2/currencies?scope=all</code></pre><h2 id="currency">Currency</h2> <p>Get details and provider coverage for a single currency.</p><pre><code class="language-json">curl https://api.frankfurter.dev/v2/currency/eur</code></pre><h2 id="providers">Providers</h2> <p>List the providers behind the API.</p><pre><code class="language-json">curl https://api.frankfurter.dev/v2/providers</code></pre><p>Get details for a single provider.</p><pre><code class="language-json">curl https://api.frankfurter.dev/v2/providers/ecb</code></pre><h3 id="rates-by-provider">Rates by Provider</h3> <p> Query rates directly from a specific provider. Supports the same parameters as <code>/v2/rates</code> and <code>/v2/rate</code>. </p><pre><code class="language-json">curl https://api.frankfurter.dev/v2/providers/ecb/rates</code></pre><p>Fetch a single currency pair from that provider.</p><pre><code class="language-json">curl https://api.frankfurter.dev/v2/providers/ecb/rate/eur/usd</code></pre><p> Combine with <code>date</code>, date ranges (<code>from</code> and <code>to</code>), or grouping. Formats like <code>.csv</code> and <code>ndjson</code> work here too. </p><pre><code class="language-json">curl https://api.frankfurter.dev/v2/providers/ecb/rates?date=2024-05-15</code></pre><h2 id="conversion">Conversion</h2> <p> There's no conversion endpoint. Fetch the rate and convert in a few lines of code. </p><pre><code class="language-javascript" data-run>function convert(base, quote, amount) {
  const api = "https://api.frankfurter.dev";
  return fetch(`${api}/v2/rate/${base}/${quote}`)
    .then((r) =&gt; r.json())
    .then((d) =&gt; (amount * d.rate).toFixed(2));
}

convert("eur", "usd", 10).then((result) =&gt;
  alert(`10 EUR = ${result} USD`)
);</code></pre><h2 id="errors">Errors</h2> <p>The API returns standard HTTP status codes with a JSON body.</p><pre><code class="language-json" data-nocopy>{
  "status": 422,
  "message": "invalid currency: ABC"
}</code></pre><dl> <dt><code>400</code></dt> <dd>Invalid parameter or malformed request.</dd> <dt><code>404</code></dt> <dd>Currency, rate, or resource not found.</dd> <dt><code>422</code></dt> <dd>Request understood but cannot be processed.</dd> </dl> <h2 id="self-hosting">Self-Hosting</h2> <p> You can <a href="/deploy/">self-host with Docker</a>. See the deploy guide for production setup and API key configuration. </p> <h2 id="faq">FAQ</h2> <dl> <dt>Who is Frankfurter for (and who is it not for)?</dt> <dd> It works well for SaaS billing, e-commerce, tax reporting, ERP and accounting systems, and academic research across historical series back to 1948. It isn't built for live trading, or for exotic currencies with wild intraday swings. </dd> <dt>Is the API free for commercial use?</dt> <dd> Yes. The rates themselves fall under each provider's <a href="/license/#providers">terms</a>. </dd> <dt>Does the API have any call limits?</dt> <dd> There are no quotas. Requests are rate-limited to prevent abuse, but there are no monthly or daily caps. For high-volume use, consider caching responses, self-hosting, or querying the datasets directly. </dd> <dt>Does the API support GraphQL?</dt> <dd> No. The REST API is simple enough that GraphQL would add complexity without much benefit. It would also break edge caching, which keeps the API fast. Use query parameters like <code>base</code>, <code>quotes</code>, and <code>from</code>/<code>to</code> to get exactly the data you need. </dd> <dt>Is the v1 API being retired?</dt> <dd> No. The v1 API is deprecated in favor of v2, but remains available indefinitely. See the <a href="/v1/">v1 documentation</a>. For European Central Bank data, use <a href="#rates-by-provider">/v2/providers/ecb/rates</a>. </dd> <dt>What is the privacy policy of the API?</dt> <dd> The API doesn't collect or log personal data, IP addresses, or request URLs. The public instance runs behind Cloudflare for caching and DDoS defense, which only provides aggregate traffic stats. </dd> <dt>Do I need to disclose the API in App Store or Google Play privacy labels?</dt> <dd> No. Because queries are anonymous and no request logs are retained, requests qualify as Data Not Collected under Apple and Google Play guidelines. </dd> <dt>Where can I report a bug or ask a question?</dt> <dd> Open an <a href="https://github.com/lineofflight/frankfurter/issues" target="_blank" rel="noopener" >issue</a > to report a bug, request a feature, or suggest a new provider. Use <a href="https://github.com/lineofflight/frankfurter/discussions" target="_blank" rel="noopener" >Discussions</a > to ask questions or share a library or tool you built with Frankfurter. </dd> <dt>How accurate are the rates?</dt> <dd> For compliance, filter by a specific provider to get official reference rates. For general use, the default blended rates work well, though the last decimal places may shift as new data comes in. </dd> <dt>Are rates mid, bid, or ask?</dt> <dd> The API returns mid-market rates. When a provider publishes bid and ask quotes instead of a reference rate, Frankfurter stores both and calculates the midpoint. </dd> <dt>Are all exchange rates daily?</dt> <dd> Almost all are. Some sources provide weekly, monthly, or quarterly observations. These sources are excluded from the blended feed. Query them directly with the <code>providers</code> filter. </dd> <dt>Why do some old and new currencies have overlapping dates?</dt> <dd> Some providers backdate replacement currencies into the old currency's period (for example, <code>TRL</code> ends in 2010 while <code>TRY</code> starts in 1996). We record provider data as is, and only filter out overlaps when blending. </dd> <dt>Why Frankfurter?</dt> <dd> <span id="name-origin">Because the European Central Bank, our original data source, is in Frankfurt.</span> <div id="faq-scene"><svg xmlns="http://www.w3.org/2000/svg" class="ecb-scene" role="img" viewBox="0 0 120 64" shape-rendering="crispEdges"> <title>European Central Bank and Main riverfront, Frankfurt</title> <style> .ecb-scene :is(.p, .g, .s, .l) { fill: var(--tx-1, #1a1a1a) } .ecb-scene .g { fill-opacity: 0.7 } .ecb-scene .s { fill-opacity: 0.4 } .ecb-scene .l { fill-opacity: 0.18 } .ecb-scene .m { fill: var(--bg-1, #ffffff) } @media (prefers-color-scheme: dark) { .ecb-scene :is(.p, .g, .s, .l) { fill: var(--tx-1, #e0e0e0) } .ecb-scene .m { fill: var(--bg-1, #141414) } } </style> <rect class="p" x="59" y="2" width="1" height="1"/> <rect class="p" x="59" y="3" width="1" height="1"/> <rect class="p" x="59" y="4" width="1" height="2"/> <rect class="p" x="60" y="6" width="5" height="1"/> <rect class="g" x="52" y="7" width="1" height="1"/> <rect class="p" x="53" y="7" width="1" height="1"/> <rect class="p" x="58" y="7" width="3" height="1"/> <rect class="l" x="61" y="7" width="1" height="1"/> <rect class="g" x="62" y="7" width="3" height="1"/> <rect class="p" x="65" y="7" width="2" height="1"/> <rect class="g" x="50" y="8" width="1" height="1"/> <rect class="p" x="51" y="8" width="1" height="1"/> <rect class="s" x="52" y="8" width="1" height="1"/> <rect class="p" x="53" y="8" width="5" height="1"/> <rect class="m" x="58" y="8" width="1" height="1"/> <rect class="l" x="59" y="8" width="3" height="1"/> <rect class="p" x="62" y="8" width="1" height="1"/> <rect class="s" x="63" y="8" width="3" height="1"/> <rect class="p" x="66" y="8" width="1" height="1"/> <rect class="g" x="46" y="9" width="1" height="1"/> <rect class="p" x="47" y="9" width="3" height="1"/> <rect class="s" x="50" y="9" width="3" height="1"/> <rect class="g" x="53" y="9" width="5" height="1"/> <rect class="m" x="58" y="9" width="1" height="1"/> <rect class="l" x="59" y="9" width="4" height="1"/> <rect class="g" x="63" y="9" width="4" height="1"/> <rect class="p" x="67" y="9" width="1" height="1"/> <rect class="g" x="44" y="10" width="1" height="1"/> <rect class="p" x="45" y="10" width="1" height="1"/> <rect class="s" x="46" y="10" width="6" height="1"/> <rect c